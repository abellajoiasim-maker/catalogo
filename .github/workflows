
name: Gerar Sitemap e Feed Merchant (SEO IQ200)

on:
  schedule:
    # Todos os dias às 06:00 UTC (03:00 horário de Brasília)
    - cron: '0 6 * * *'
  push:
    branches: [main]
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  seo-feeds:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Gerar sitemap.xml a partir do Firebase
        run: node scripts/generate-sitemap.mjs

      - name: Gerar merchant-feed.xml a partir do Firebase
        run: node scripts/generate-merchant-feed.mjs

      - name: Commit sitemap.xml e merchant-feed.xml se houver mudanças
        run: |
          git config user.name "seo-iq200-bot"
          git config user.email "actions@github.com"
          git add sitemap.xml merchant-feed.xml
          if git diff --cached --quiet; then
            echo "Nenhuma alteração em sitemap.xml ou merchant-feed.xml."
          else
            git commit -m "chore(seo): atualizar sitemap.xml e merchant-feed.xml automaticamente"
            git push
          fi
